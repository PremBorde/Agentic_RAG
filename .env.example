# =====================================================================
# Personal AI Agent Studio — Environment Configuration
# =====================================================================

# 1. Google Gemini API (Required for reasoning & generation)
# Obtain your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Google OAuth 2.0 Credentials (Required for Gmail & Google Calendar)
# Steps to obtain:
#   a. Go to Google Cloud Console (https://console.cloud.google.com/)
#   b. Create a project and enable:
#        - Gmail API
#        - Google Calendar API
#   c. Configure OAuth Consent Screen (User Type: External, Testing mode)
#      Add Test Users: add your personal Gmail address.
#   d. Under Credentials -> Create Credentials -> OAuth client ID:
#        - Application type: Web application
#        - Authorized redirect URIs: http://localhost:8000/api/auth/google/callback
#   e. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
ENCRYPTION_KEY=your_fernet_encryption_key_here

# 3. Optional MCP Configuration (Future integrations)
MCP_ENABLED=false
